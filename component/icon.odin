package component

import k "kashmir:."

// ---------- enums ----------

// Phosphor ships one font per weight. A browser downloads a weight's font only
// when something on the page draws with it.
Icon_Weight :: enum u8 {
	regular,
	thin,
	light,
	bold,
	fill,
	duotone,
}

@(private)
icon_weight_classes := [Icon_Weight]string {
	.regular = "ph",
	.thin    = "ph-thin",
	.light   = "ph-light",
	.bold    = "ph-bold",
	.fill    = "ph-fill",
	.duotone = "ph-duotone",
}

// ---------- constants ----------

ICON_EXTRAS_MAX :: 2 // role, aria-label or aria-hidden

// ---------- props ----------

// A Phosphor icon, drawn from a font so one cached file serves every icon on
// every page. The glyph inherits the text color, so set color on the icon or a
// parent. Icon_Name and the font CSS are generated by tools/icons.
//
//   icon(doc, {name = .check_circle, weight = .fill, size = .large})
//
// The zero value draws nothing. Icons are hidden from screen readers unless
// aria_label is set. Set it when the icon carries meaning on its own, with no
// adjacent text.
//
// Size is the shared Size enum: Small 16px, Medium 24px (default), Large 32px.
Icon_Props :: struct {
	using base: k.Base, // id, class (appended after the generated classes), style, attributes
	name:       Icon_Name, // see icon_names.odin
	weight:     Icon_Weight,
	size:       Size, // see component.odin
	aria_label: string,
}

// ---------- procs ----------

// Composition order: icon icon--{size} {weight class} [ph-{name}] [class]
icon :: proc(doc: ^k.Doc, props: Icon_Props) -> k.Node_Id {
	assert(
		props.weight != .duotone || icon_duotone_available(props.name),
		"icon has no duotone form",
	)

	// k.i copies the slice into the Doc, so a bounded stack buffer is enough.
	attributes: [ATTRIBUTES_MAX]k.Attribute
	attributes_count := len(props.attributes)
	assert(
		attributes_count + ICON_EXTRAS_MAX <= ATTRIBUTES_MAX,
		"icon attributes exceeds ATTRIBUTES_MAX",
	)
	copy(attributes[:], props.attributes)

	if props.aria_label != "" {
		attributes[attributes_count] = k.role("img")
		attributes_count += 1
		attributes[attributes_count] = k.attribute("aria-label", props.aria_label)
		attributes_count += 1
	} else {
		attributes[attributes_count] = k.attribute("aria-hidden", "true")
		attributes_count += 1
	}

	base := props.base
	base.class = icon_class(doc, props)
	base.attributes = attributes[:attributes_count]
	return k.i(doc, base)
}

@(private)
icon_class :: proc(doc: ^k.Doc, props: Icon_Props) -> string {
	name_class :=
		props.name == .none ? "" : k.doc_format(doc, " ph-%s", icon_name_classes[props.name])
	separator := props.class != "" ? " " : ""

	return k.doc_format(
		doc,
		"icon icon--%s %s%s%s%s",
		size_names[props.size],
		icon_weight_classes[props.weight],
		name_class,
		separator,
		props.class,
	)
}
