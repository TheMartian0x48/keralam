// Font file for each weight, as shipped by @phosphor-icons/web. The caller serves
// them and declares @font-face for the families in phosphor.css (see readme.md).
icon_font_version :: "2.1.2"
icon_font_files := [Icon_Weight]string {
	.regular = "Phosphor.woff2",
	.thin = "Phosphor-Thin.woff2",
	.light = "Phosphor-Light.woff2",
	.bold = "Phosphor-Bold.woff2",
	.fill = "Phosphor-Fill.woff2",
	.duotone = "Phosphor-Duotone.woff2",
}

// Duotone has no form for a few icons; drawing one would show a blank.
icon_duotone_available :: proc(name: Icon_Name) -> bool {
	#partial switch name {
	case .caduceus, .archive_box, .file_dotted, .file_search,
	     .folder_notch, .folder_dotted, .folder_notch_minus, .folder_notch_open,
	     .folder_notch_plus, .folder_simple_dotted, .lemniscate, .activity,
	     .circle_wavy, .circle_wavy_check, .circle_wavy_question, .circle_wavy_warning,
	     .text_bolder, .archive_tray:
		return false
	}
	return true
}
